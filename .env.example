# .env.example
# Copy this file to .env and fill in the values you need.
# NEVER commit .env to Git.

# ── Gemini API (provider 1) ───────────────────────────────────────────────
# Required only when you select the Gemini provider at startup.
# Obtain from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── LM Studio local inference (provider 2) ───────────────────────────────
# Required only when you select the LM Studio provider at startup.
# These values are optional; the defaults shown below are used if omitted.

# Base URL of your running LM Studio server (include /v1 suffix).
# Default: http://localhost:1234/v1
LM_STUDIO_BASE_URL=http://localhost:1234/v1

# Model identifier to use.  Leave empty to auto-detect from /v1/models.
# The identifier must exactly match what LM Studio reports (e.g. the name
# shown in the 'Local Server' tab under 'Models').
LM_STUDIO_MODEL=

# Per-request timeout in seconds.  Local models on slower hardware may need
# a higher value.  Default: 60
LM_STUDIO_TIMEOUT=60
